{
  "name": "apkstart",
  "productName": "ApkStart",
  "version": "0.5.0",
  "description": "极致轻量的 Windows 安卓应用运行器：双击 APK 即装，应用以独立窗口与桌面图标运行",
  "main": "src/main.js",
  "author": "RoutineMiku",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/RoutineMiku/apkstart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoutineMiku/apkstart.git"
  },
  "bugs": {
    "url": "https://github.com/RoutineMiku/apkstart/issues"
  },
  "keywords": [
    "android",
    "emulator",
    "apk",
    "windows",
    "qemu",
    "electron",
    "wsa",
    "freeform"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "linux"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run-tests.js && node test/engine-test.js && node test/auto-test.js",
    "check:i18n": "node tools/check-i18n.js",
    "pack": "node build/pack.js",
    "runtime": "node build/prepare-runtime.js",
    "build:exe": "node build/prepare-runtime.js && electron-builder --win nsis",
    "selftest": "node scripts/selftest.js",
    "assoc:on": "node scripts/assoc.js on",
    "assoc:off": "node scripts/assoc.js off",
    "test:boot": "node test/boot-test.js",
    "pack:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.routinemiku.apkstart",
    "productName": "ApkStart",
    "directories": {
      "output": "dist-linux"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!src/ui/assets/*.jpg"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "src/ui/assets/logo-128.png",
      "desktop": {
        "Name": "ApkStart",
        "Comment": "在 FydeOS / Linux 上管理安卓应用",
        "Categories": "Utility;"
      }
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@napi-rs/lzma": "^1.5.3"
  }
}
